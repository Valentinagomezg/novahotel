# ============================================================
# NOVA Hotels - variables de entorno
# Copia este archivo a .env.floci (o define estas variables en
# tu sistema/IDE). .env.floci se genera automaticamente con
# scripts/floci-local.ps1 y no se versiona.
# ============================================================

# --- Base de datos (Azure SQL / SQL Server local con Floci AZ) ---
# En Azure: jdbc:sqlserver://<servidor>.database.windows.net:1433;databaseName=NovaHotelDB;encrypt=true;trustServerCertificate=false;loginTimeout=30;
# En Floci: el puerto lo asigna Docker; scripts/floci-local.ps1 lo escribe aqui.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=NovaHotelDB;encrypt=true;trustServerCertificate=true;loginTimeout=30;
DB_USERNAME=sa
DB_PASSWORD=YourStrong!Passw0rd

# --- Aplicacion ---
APP_BASE_URL=http://localhost:8080
SERVER_PORT=8080

# --- Correo (Gmail SMTP por defecto) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENABLED=true
MAIL_FROM=
